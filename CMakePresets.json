{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "release",
      "inherits": ["default"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "install-nonroot",
      "inherits": ["release"],
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "install",
      "configurePreset": "release",
      "targets": ["install"]
    },
    {
      "name": "install-nonroot",
      "configurePreset": "install-nonroot",
      "targets": ["install"]
    },
    {
      "name": "uninstall",
      "configurePreset": "release",
      "targets": ["uninstall"]
    },
    {
      "name": "uninstall-nonroot",
      "configurePreset": "install-nonroot",
      "targets": ["uninstall"]
    }
  ],
  "workflowPresets": [
    {
      "name": "build",
      "steps": [
        {
          "name": "default",
          "type": "configure"
        },
        {
          "name": "default",
          "type": "build"
        }
      ]
    },
    {
      "name": "install",
      "steps": [
        {
          "name": "release",
          "type": "configure"
        },
        {
          "name": "install",
          "type": "build"
        }
      ]
    },
    {
      "name": "install-nonroot",
      "steps": [
        {
          "name": "install-nonroot",
          "type": "configure"
        },
        {
          "name": "install-nonroot",
          "type": "build"
        }
      ]
    },
    {
      "name": "uninstall",
      "steps": [
        {
          "name": "release",
          "type": "configure"
        },
        {
          "name": "uninstall",
          "type": "build"
        }
      ]
    },
    {
      "name": "uninstall-nonroot",
      "steps": [
        {
          "name": "install-nonroot",
          "type": "configure"
        },
        {
          "name": "uninstall-nonroot",
          "type": "build"
        }
      ]
    }
  ]
}
